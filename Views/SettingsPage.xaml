<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TimeTracker.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TimeTracker.Views"
    xmlns:viewModels="using:TimeTracker.ViewModels"
    xmlns:models="using:TimeTracker.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:ApplicationsViewModel />
    </Page.DataContext>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
             Background="White"
             Padding="40,20"
             BorderBrush="#E5E5E5"
             BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding HeaderTitle}"
                            Style="{StaticResource PageHeaderTextStyle}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}"
                            Margin="0,6,0,0"
                            Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <!-- Кнопка сохранить -->
                <Button Grid.Column="1"
                        Content="Сохранить"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>

            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20" Spacing="15">

                <!-- Совет -->
                <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E5E5E5" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding TipsTitle}" Style="{StaticResource SectionTitleTextStyle}"/>

                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="8"
                                    Margin="0,0,10,0"
                                    Background="#F3F4F6"
                                    VerticalAlignment="Top">
                                <FontIcon Glyph="&#xea1f;" FontSize="18" Foreground="#548AC5"/>
                            </Border>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding TipsText}" 
                                       Style="{StaticResource CaptionTextStyle}" 
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Настройки -->
                <Border Background="White"
                        CornerRadius="12"
                        Padding="20"
                        BorderBrush="#E5E5E5"
                        BorderThickness="1">

                    <StackPanel Spacing="24">

                        <!-- Дневной лимит -->
                        <StackPanel Spacing="8">

                            <TextBlock Text="Дневной лимит"
                                       Style="{StaticResource SectionTitleTextStyle}" />

                            <Grid ColumnDefinitions="400, *" 
                                  VerticalAlignment="Center">
                                <TextBlock Grid.Column="0"
                                           Text="Максимальное время использования ПК за день."   
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" 
                                           Style="{StaticResource CaptionTextStyle}" />

                                <NumberBox Grid.Column="1"
                                           Value="{Binding DailyLimitHours, Mode=TwoWay}"
                                           Style="{StaticResource PrimaryNumberBoxStyle}"
                                           Background="#6B7280" 
                                           Minimum="1"
                                           Maximum="24"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Inline"
                                           Header="Часы"
                                           Margin="0,-24,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- API ключ -->
                        <StackPanel Spacing="8">

                            <TextBlock Text="API ключ"
                                       Style="{StaticResource SectionTitleTextStyle}" />

                            <Grid ColumnDefinitions="400, *" 
                                  VerticalAlignment="Center">
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" 
                                           Text="Ключ для интеграции AI-функций."
                                           Style="{StaticResource CaptionTextStyle}" />

                                <PasswordBox Grid.Column="1"
                                             Background="#6B7280" 
                                             Password="{Binding ApiKey, Mode=TwoWay}" 
                                             Style="{StaticResource PrimaryPasswordBoxStyle}" />
                                
                            </Grid>
                        </StackPanel>

                        <!-- Автозапуск -->
                        <StackPanel Spacing="8">

                            <TextBlock Text="Автозапуск"
                                       Style="{StaticResource SectionTitleTextStyle}" />

                            <Grid ColumnDefinitions="400, *" 
                                  VerticalAlignment="Center">
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" 
                                           Text="Автоматически запускать приложение при входе в Windows."
                                           Style="{StaticResource CaptionTextStyle}" />

                                <ToggleSwitch Grid.Column="1"
                                              Foreground="#6B7280"
                                              IsOn="{Binding IsAutoStartEnabled, Mode=TwoWay}"
                                              Style="{StaticResource PrimaryToggleSwitchStyle}"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>


            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
